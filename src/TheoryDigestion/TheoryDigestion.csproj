<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Engine/Digestion/Scope/ReferenceSources.txt" LogicalName="TheoryDigestion.ReferenceSources" />
    <InternalsVisibleTo Include="TheoryDigestion.Tests" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Dunet" Version="1.16.2" PrivateAssets="all" />
    <PackageReference Include="Pidgin" Version="3.5.1" />
  </ItemGroup>
</Project>
